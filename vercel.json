{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": ["firebase-applet-config.json", "*.json"]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
