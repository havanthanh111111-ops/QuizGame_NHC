{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": ["firebase-applet-config.json", "*.json", "db.json", "scores.json", "teachers.json", "classes.json", "admin_config.json"]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
